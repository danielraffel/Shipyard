<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily bounded retention pass for a Shipyard host. Install with
  scripts/install_cleanup.sh; the wrapper records success or refusal in the
  state directory so `shipyard doctor` can surface a broken queue or stale
  scheduler without relying on launchd's private log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.shipyard.cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>@WRAPPER@</string>
        <string>--shipyard</string>
        <string>@SHIPYARD@</string>
        <string>--state-dir</string>
        <string>@STATE_DIR@</string>
        <string>--status</string>
        <string>@STATUS@</string>
        <string>--older-than-hours</string>
        <string>@OLDER_THAN_HOURS@</string>
        <string>--interval</string>
        <string>@INTERVAL@</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>@INTERVAL@</integer>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>SHIPYARD_VALIDATION_TMP_BASE</key>
        <string>@VALIDATION_TMP_BASE@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:@HOME@/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
