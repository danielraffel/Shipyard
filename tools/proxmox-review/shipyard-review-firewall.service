[Unit]
Description=Fail-closed firewall for Shipyard untrusted review VMs
After=network-pre.target
Before=network.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /etc/nftables.d/shipyard-review-firewall.nft
ExecStart=/usr/sbin/nft -f /etc/nftables.d/shipyard-review-firewall.nft
ExecReload=/bin/sh -c '/usr/sbin/nft -c -f /etc/nftables.d/shipyard-review-firewall.nft || exit 1; /usr/sbin/nft delete table inet shipyard_review 2>/dev/null || true; exec /usr/sbin/nft -f /etc/nftables.d/shipyard-review-firewall.nft'
ExecStop=/usr/sbin/nft delete table inet shipyard_review

[Install]
WantedBy=network-pre.target
