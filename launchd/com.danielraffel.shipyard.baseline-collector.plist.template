<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.danielraffel.shipyard.baseline-collector</string>
<key>ProgramArguments</key><array><string>@PYTHON@</string><string>@WRAPPER@</string>
<string>--collector</string><string>@COLLECTOR@</string><string>--handoff-script</string><string>@HANDOFF@</string>
<string>--repo</string><string>@REPO@</string><string>--base-branch</string><string>@MERGE_RECEIPT_BASE_BRANCH@</string>
