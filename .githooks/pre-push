#!/usr/bin/env bash
# Shipyard pre-push hook (agent-agnostic).
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
if [ "${SHIPYARD_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "[pre-push] SHIPYARD_SKIP_PREPUSH=1 — skipping gates." >&2
    exit 0
fi
PYTHON="${PYTHON:-python3}"
VBC="$ROOT/scripts/version_bump_check.py"
SSC="$ROOT/scripts/skill_sync_check.py"
CFG="$ROOT/scripts/versioning.json"
DSC="$ROOT/scripts/doc_sync_check.py"
DSM="$ROOT/scripts/doc_sync_map.json"
missing_gate_inputs=""
[ -f "$VBC" ] || missing_gate_inputs="$missing_gate_inputs $VBC"
[ -f "$SSC" ] || missing_gate_inputs="$missing_gate_inputs $SSC"
[ -f "$CFG" ] || missing_gate_inputs="$missing_gate_inputs $CFG"
if [ -n "$missing_gate_inputs" ]; then
    echo "[pre-push] SKIPPED — version/skill gates did not run: pre-versioning checkout." >&2
    echo "[pre-push]   Missing:$missing_gate_inputs" >&2
    echo "[pre-push]   Nothing was verified. This is a SKIP, not a pass." >&2
    exit 0
fi
gate_could_not_run() {
    local name="$1" status="$2"
    echo "[pre-push] $name: COULD NOT RUN (exit $status) — treating as a FAILURE." >&2
    echo "[pre-push]   The gate performed no check, so it cannot report a pass." >&2
    echo "[pre-push]   Its output above names the config it looked for." >&2
}
BASE="${SHIPYARD_PREPUSH_BASE:-origin/main}"
fail=0
blocking_fail=0
advisory_fail=0
"$PYTHON" "$SSC" --base "$BASE" --config "$CFG" --mode=report
gate_rc=$?; case $gate_rc in
    0) ;;
    1) fail=1 ;;
    *) gate_could_not_run "skill_sync_check" "$gate_rc"; fail=1 ;;
esac

"$PYTHON" "$VBC" --base "$BASE" --config "$CFG" --mode=report
gate_rc=$?; case $gate_rc in
    0) ;;
    1) fail=1 ;;
    *) gate_could_not_run "version_bump_check" "$gate_rc"; fail=1 ;;
esac

if [ -f "$DSC" ] && [ -f "$DSM" ]; then
    "$PYTHON" "$DSC" --base "$BASE" --map "$DSM" --mode=report
    gate_rc=$?; case $gate_rc in
        0) ;;
        1) fail=1 ;;
        *) gate_could_not_run "doc_sync_check" "$gate_rc"; fail=1 ;;
    esac
fi
changed_files="$(git diff --name-only "$BASE" 2>/dev/null || true)"
if [ -n "$changed_files" ]; then
    # Fast source guard: only changed Rust files are inspected.
    "$PYTHON" "$ROOT/scripts/check_test_include_str.py" --base "$BASE" $changed_files || blocking_fail=1
fi
assert_rustup_proxy() {
    local rustc_path target
    rustc_path="$(command -v rustc 2>/dev/null || true)"
    case "$rustc_path" in
        "$HOME/.cargo/bin/rustc")
            target="$(readlink "$rustc_path" 2>/dev/null || true)"
            case "$target" in rustup|*/rustup) return 0 ;; esac
            ;;
    esac
    echo "[pre-push] PATH rustc must be the rustup proxy; got ${rustc_path:-missing}." >&2
    return 1
}
check_pinned_toolchain() {
    local channel
    channel="$(sed -n 's/^channel = "\([^"]*\)"/\1/p' rust-toolchain.toml 2>/dev/null)"
    if [ -z "$channel" ] || ! command -v rustup >/dev/null 2>&1; then
        return 0
    fi
    # rustup names an installed toolchain `<channel>-<host triple>`, so match
    # the channel itself or the channel followed by `-`. Auto-install is off
    # so the probe never stalls fetching the pinned channel.
    if ! RUSTUP_AUTO_INSTALL=0 rustup toolchain list 2>/dev/null \
        | awk -v channel="$channel" '$1 == channel || index($1, channel "-") == 1 { found = 1 } END { exit !found }'; then
        echo "[pre-push] pinned Rust $channel is not installed." >&2
        echo "[pre-push] Run: rustup toolchain install $channel --profile minimal --component rustfmt --component clippy" >&2
        return 1
    fi
}
is_m3() { [[ "${SHIPYARD_HOST:-}" == "m3" || "$(uname -n 2>/dev/null)" == *m3* ]]; }
m1_cmd="ssh m1 'cd $ROOT && cargo"
assert_rustup_proxy || blocking_fail=1
check_pinned_toolchain || blocking_fail=1
if is_m3; then
    echo "[pre-push] Rust gates require m1; Cargo is forbidden on m3." >&2
    echo "[pre-push] Run on m1: $m1_cmd fmt --all --check'" >&2
    if echo "$changed_files" | grep -Eq '^(src|tests)/'; then
      echo "[pre-push] Run on m1: $m1_cmd clippy --all-targets --locked -- -D warnings'" >&2
    fi
    blocking_fail=1
else
    cargo fmt --all --check || {
        echo "[pre-push] cargo fmt --check failed." >&2
        blocking_fail=1
    }
    if echo "$changed_files" | grep -Eq '^(src|tests)/'; then
      cargo clippy --all-targets --locked -- -D warnings || {
        echo "[pre-push] cargo clippy -D warnings failed." >&2
        blocking_fail=1
      }
    fi
fi
if [ "$blocking_fail" = "0" ] && [ "$fail" = "0" ]; then
    echo "[pre-push] gates clean." >&2
    exit 0
fi
if [ "$blocking_fail" != "0" ]; then
    echo "[pre-push] blocking Rust/source gates failed — push refused." >&2
    exit 1
fi
if [ "${SHIPYARD_ENFORCE_PREPUSH:-0}" = "1" ]; then
    echo "[pre-push] SHIPYARD_ENFORCE_PREPUSH=1 — blocking push due to gate failures above." >&2
    exit 1
fi
echo "[pre-push] warnings above are advisory (export SHIPYARD_ENFORCE_PREPUSH=1 to block)." >&2
exit 0
