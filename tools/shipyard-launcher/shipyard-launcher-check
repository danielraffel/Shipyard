#!/usr/bin/env python3
"""Report, activate or deactivate ShipyardLauncher.app on this host.

  shipyard-launcher-check [--json]      read-only report; exit 0 when ready
  shipyard-launcher-check --activate    write the activation record, only when ready
  shipyard-launcher-check --deactivate  remove the activation record
  shipyard-launcher-check --verify-bundle PATH
                                        signature, team and notarization of one
                                        bundle (fleet-deploy uses this)

"Ready" means: the installed bundle is Developer ID signed with the bundle
identifier, by the same team as the installed Shipyard; it is notarized; the
launcher accepts the current release; and the launcher holds Full Disk Access.

The Full Disk Access check starts the launcher through LaunchServices (`open`),
so the launcher is its own responsible process, exactly as under launchd. The
launcher then opens the system TCC database, which only a process with Full
Disk Access can open. That never raises a prompt, and nothing reads /Volumes.

--activate writes ~/.local/share/shipyard/launcher/activation.json bound to
this exact bundle: path, identifier, team and code directory hash, plus the
time the grant was confirmed. Routing asks the launcher itself
(`shipyard-launcher --launcher-active`), which accepts the record only for
that exact bundle and rechecks the grant through LaunchServices once the
confirmation is older than an hour. A revoked grant demotes the record, and a
replaced bundle, a different team, or an unreadable record is "not active",
so a launcher without a grant can never raise an unattended prompt.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
import time

BUNDLE_ID = "com.danielraffel.shipyard.launcher"
HOME = pathlib.Path(os.environ.get("SHIPYARD_LAUNCHER_CHECK_HOME") or pathlib.Path.home())
APP = HOME / ".local" / "libexec" / "ShipyardLauncher.app"
EXECUTABLE = APP / "Contents" / "MacOS" / "shipyard-launcher"
RECORD = HOME / ".local" / "share" / "shipyard" / "launcher" / "activation.json"
SHIPYARD = HOME / ".local" / "bin" / "shipyard"
CODESIGN = os.environ.get("SHIPYARD_LAUNCHER_CHECK_CODESIGN", "/usr/bin/codesign")
SPCTL = os.environ.get("SHIPYARD_LAUNCHER_CHECK_SPCTL", "/usr/sbin/spctl")
OPEN = os.environ.get("SHIPYARD_LAUNCHER_CHECK_OPEN", "/usr/bin/open")
ACCESS_WAIT_SECS = float(os.environ.get("SHIPYARD_LAUNCHER_CHECK_WAIT_SECS", "20"))


TOOL_TIMEOUT_SECS = float(os.environ.get("SHIPYARD_LAUNCHER_CHECK_TOOL_TIMEOUT_SECS", "60"))


def tool(args: list[str]) -> subprocess.CompletedProcess:
    """Run a tool; a hang or a missing tool is a failed result, never a pass."""
    try:
        return subprocess.run(
            args, capture_output=True, text=True, check=False,
            stdin=subprocess.DEVNULL, timeout=TOOL_TIMEOUT_SECS,
        )
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", f"{args[0]} timed out after {TOOL_TIMEOUT_SECS:.0f}s")
    except OSError as error:
        return subprocess.CompletedProcess(args, 127, "", f"cannot run {args[0]}: {error}")


def notarized(assessment: subprocess.CompletedProcess) -> bool:
    """spctl accepted it and named the source exactly."""
    lines = [line.strip() for line in (assessment.stdout + assessment.stderr).splitlines()]
    return assessment.returncode == 0 and "source=Notarized Developer ID" in lines


def team_of(path: pathlib.Path) -> str | None:
    result = tool([CODESIGN, "-dv", "--verbose=2", str(path)])
    for line in (result.stdout + result.stderr).splitlines():
        if line.startswith("TeamIdentifier="):
            value = line.split("=", 1)[1].strip()
            return value if value and value != "not set" else None
    return None


def requirement(team: str) -> str:
    return (
        f'identifier "{BUNDLE_ID}" and anchor apple generic'
        " and certificate 1[field.1.2.840.113635.100.6.2.6] exists"
        " and certificate leaf[field.1.2.840.113635.100.6.1.13] exists"
        f' and certificate leaf[subject.OU] = "{team}"'
    )


def verify_bundle(app: pathlib.Path) -> tuple[bool, str]:
    """Developer ID signed launcher of the installed Shipyard's team, notarized."""
    if not app.is_dir() or app.is_symlink():
        return False, f"{app} is not a bundle directory"
    team = team_of(SHIPYARD.resolve()) if SHIPYARD.exists() else None
    if not team or not re.fullmatch(r"[A-Z0-9]{10}", team):
        return False, f"cannot read the Team ID of {SHIPYARD}; refusing to trust any launcher"
    result = tool([CODESIGN, "--verify", "--strict", "--deep", f"-R={requirement(team)}", str(app)])
    if result.returncode != 0:
        return False, f"signature does not satisfy the {team} Developer ID launcher requirement: {(result.stderr or result.stdout).strip()}"
    assessment = tool([SPCTL, "--assess", "--type", "execute", "-vv", str(app)])
    detail = (assessment.stdout + assessment.stderr).strip()
    if not notarized(assessment):
        return False, f"not notarized: {detail}"
    return True, f"Developer ID {team}, notarized"


def launcher_verify() -> tuple[bool, str]:
    result = tool([str(EXECUTABLE), "--launcher-verify"])
    if result.returncode != 0:
        return False, (result.stderr or result.stdout).strip() or f"exit {result.returncode}"
    try:
        report = json.loads(result.stdout)
    except ValueError:
        return False, f"unreadable --launcher-verify output: {result.stdout!r}"
    if not isinstance(report, dict) or report.get("ok") is not True or not report.get("target"):
        return False, f"--launcher-verify did not report ok: {result.stdout!r}"
    return True, report["target"]


def full_disk_access() -> tuple[str, str]:
    """('granted' | 'denied' | 'unknown', detail)."""
    with tempfile.TemporaryDirectory(prefix="shipyard-launcher-check-") as temp:
        result_file = pathlib.Path(temp) / "access.json"
        opened = tool([OPEN, "-n", "-g", "-a", str(APP), "--args",
                       "--launcher-check-access", "--launcher-result", str(result_file)])
        if opened.returncode != 0:
            return "unknown", f"could not start the launcher through LaunchServices (run this at the console or in the GUI session): {(opened.stderr or opened.stdout).strip()}"
        deadline = time.monotonic() + ACCESS_WAIT_SECS
        while time.monotonic() < deadline:
            try:
                report = json.loads(result_file.read_text())
                break
            except (OSError, ValueError):
                time.sleep(0.2)
        else:
            return "unknown", f"the launcher did not report within {ACCESS_WAIT_SECS:.0f}s"
    state = report.get("full_disk_access") if isinstance(report, dict) else None
    if state not in ("granted", "denied", "unknown"):
        return "unknown", f"unexpected report {report}"
    # Only a launcher that LaunchServices started (parent launchd) is its own
    # responsible process; any other parent makes the answer someone else's.
    if report.get("ppid") != 1:
        return "unknown", f"the launcher's parent was pid {report.get('ppid')}, not launchd; the answer is not the launcher's own"
    return state, f"errno={report.get('errno')}"


def cdhash_of(path: pathlib.Path) -> str | None:
    result = tool([CODESIGN, "-dvvv", str(path)])
    for line in (result.stdout + result.stderr).splitlines():
        if line.startswith("CDHash="):
            value = line.split("=", 1)[1].strip()
            return value if re.fullmatch(r"[0-9a-f]{40,64}", value) else None
    return None


def launcher_active() -> tuple[bool, str]:
    """The launcher's own verdict (--launcher-active): the record names this
    exact bundle (path, identifier, team, code directory hash) and a Full Disk
    Access grant confirmed within the launcher's cache window, or confirmed
    again now. A revoked grant demotes the record. Anything unclear is "not
    active"."""
    if not EXECUTABLE.is_file():
        return False, "launcher_missing"
    result = tool([str(EXECUTABLE), "--launcher-active"])
    try:
        report = json.loads(result.stdout)
    except ValueError:
        report = {}
    reason = report.get("reason") if isinstance(report, dict) else None
    reason = reason or (result.stderr or result.stdout).strip() or f"exit {result.returncode}"
    active = result.returncode == 0 and isinstance(report, dict) and report.get("active") is True
    return active, reason


def check() -> dict:
    report: dict = {"schema": 1, "app": str(APP), "checks": {}, "ready": False}
    checks = report["checks"]
    ok, detail = verify_bundle(APP)
    checks["bundle"] = {"ok": ok, "detail": detail}
    if ok:
        ok, detail = launcher_verify()
        checks["release"] = {"ok": ok, "detail": detail}
    if ok:
        state, detail = full_disk_access()
        checks["full_disk_access"] = {"ok": state == "granted", "state": state, "detail": detail}
        ok = state == "granted"
    report["ready"] = ok
    report["activated"], report["activation"] = launcher_active()
    return report


def next_step(report: dict) -> str:
    checks = report["checks"]
    if not checks["bundle"]["ok"]:
        return ("Install a signed, notarized ShipyardLauncher.app at ~/.local/libexec/ShipyardLauncher.app "
                "(tools/shipyard-launcher/README.md, Install on a host).")
    if not checks.get("release", {}).get("ok"):
        return "The launcher refused the current release; see the detail above."
    access = checks.get("full_disk_access", {})
    if access.get("state") == "denied":
        return ("Owner step: System Settings > Privacy & Security > Full Disk Access > + > "
                "Cmd-Shift-G, enter ~/.local/libexec/ShipyardLauncher.app > Open, then turn it on. "
                "Then rerun with --activate.")
    if access.get("state") == "unknown":
        return "Rerun in the logged-in GUI session (at the console or Screen Sharing)."
    if not report["activated"]:
        return f"Ready: run with --activate (now: {report.get('activation')})."
    return "Active: launchd jobs run under ShipyardLauncher.app."


def write_record(report: dict) -> tuple[bool, str]:
    """Bind the activation to this exact bundle and the grant just confirmed,
    then ask the launcher whether it agrees. A record it does not accept is
    removed again."""
    team = team_of(SHIPYARD.resolve())
    bundle_team = team_of(APP)
    cdhash = cdhash_of(APP)
    if not team or team != bundle_team:
        return False, f"bundle team {bundle_team} is not the Shipyard team {team}"
    if not cdhash:
        return False, "cannot read the bundle's code directory hash"
    RECORD.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    record = {
        "schema": 2,
        "app": os.path.realpath(APP),
        "identifier": BUNDLE_ID,
        "team": team,
        "cdhash": cdhash,
        "designated_requirement": requirement(team),
        "fda_checked_at": time.time(),
        "activated_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "checks": report["checks"],
    }
    staged = RECORD.with_name(f".{RECORD.name}.{os.getpid()}.tmp")
    descriptor = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        json.dump(record, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(staged, RECORD)
    active, reason = launcher_active()
    if not active:
        RECORD.unlink(missing_ok=True)
        return False, f"the launcher did not accept the new record: {reason}"
    return True, reason


def print_report(report: dict) -> None:
    for name, value in report["checks"].items():
        print(f"{'ok  ' if value['ok'] else 'FAIL'} {name}: {value.get('state', '')} {value['detail']}".replace("  ", " "))
    print(f"activated: {'yes' if report['activated'] else 'no'} ({report.get('activation', '')})")
    print(f"next: {next_step(report)}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--activate", action="store_true")
    action.add_argument("--deactivate", action="store_true")
    action.add_argument("--verify-bundle", type=pathlib.Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    if sys.platform != "darwin" and not os.environ.get("SHIPYARD_LAUNCHER_CHECK_HOME"):
        print("ShipyardLauncher.app exists on macOS only", file=sys.stderr)
        return 2
    if args.verify_bundle:
        ok, detail = verify_bundle(args.verify_bundle)
        print(detail)
        return 0 if ok else 1
    if args.deactivate:
        try:
            RECORD.unlink()
            print(f"removed {RECORD}; launchd jobs run Shipyard directly again")
        except FileNotFoundError:
            print("not activated")
        return 0
    report = check()
    activation_error = None
    if args.activate and report["ready"]:
        written, detail = write_record(report)
        report["activated"], report["activation"] = written, detail
        if not written:
            activation_error = detail
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_report(report)
    if args.activate and not report["ready"]:
        print("not activated: the launcher is not ready", file=sys.stderr)
        return 1
    if activation_error:
        print(f"not activated: {activation_error}", file=sys.stderr)
        return 1
    return 0 if report["ready"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
